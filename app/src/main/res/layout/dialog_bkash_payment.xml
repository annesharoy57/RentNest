<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/review_edittext_bg"
    android:backgroundTint="@color/white">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:src="@drawable/promo"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Manual bKash Payment"
        android:textAlignment="center"
        android:textColor="#D12053"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPaymentInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Please send the rent amount to the Owner's bKash number below:"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvOwnerBkashNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F0F2F5"
        android:padding="12dp"
        android:text="017XXXXXXXX"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter Your bKash Number"
        android:textColor="#333333"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etUserBkashNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="e.g. 018XXXXXXXX"
        android:inputType="phone"
        android:padding="12dp"
        android:background="@drawable/review_edittext_bg" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Transaction ID (TxnID)"
        android:textColor="#333333"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTransactionId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="e.g. 8N7X6W5V4U"
        android:inputType="textCapCharacters"
        android:padding="12dp"
        android:background="@drawable/review_edittext_bg" />

    <Button
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#D12053"
        android:text="Payment Done"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/btnCancelPayment"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="#757575" />

</LinearLayout>