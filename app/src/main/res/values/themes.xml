<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Fixed to MaterialComponents for feature compatibility -->
    <style name="Base.Theme.HouseRentalApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_color</item>
    </style>

    <style name="Theme.HouseRentalApp" parent="Base.Theme.HouseRentalApp" />

    <!-- Splash Screen Theme (Professional Look) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050B35</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HouseRentalApp</item>
    </style>
</resources>